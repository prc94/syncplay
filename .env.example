# Copy to `.env` and fill in — Docker Compose loads it automatically.
# Leave a value blank to disable that feature.

# Password required to connect to the server (blank = open server).
SYNCPLAY_PASSWORD=

# Salt for managed-room passwords. Set a stable random value so room operator
# passwords survive restarts, e.g.  openssl rand -hex 16
SYNCPLAY_SALT=

# Server-admin password (fork feature). Enables /admin <pw> and modded-client
# auto-auth. Blank disables server admins.
SYNCPLAY_ADMIN_PASSWORD=
